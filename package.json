{
  "name": "token-monitor-lite",
  "productName": "Token Monitor Lite",
  "version": "0.1.0",
  "description": "Lightweight Token Monitor — keeps the tokscale backend, renders day/week/month stats, per-tool/per-model usage and provider limits in a small floating window.",
  "main": "src/electron/main.js",
  "author": "Javis",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "dist:win:nsis": "electron-builder --win nsis --x64 --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "pack:win:dir": "electron-builder --win dir --x64 --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "koffi": "^3.1.5",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tokscale": "^4.13.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "electron": "43.4.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "build": {
    "appId": "com.javis.tokenmonitorlite",
    "productName": "Token Monitor Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "package.json",
      "src/electron/**/*",
      "src/hub/**/*",
      "src/shared/**/*"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*",
      "node_modules/koffi/**/*"
    ],
    "win": {
      "icon": "assets/icon-win.png",
      "artifactName": "Token-Monitor-Lite-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Token-Monitor-Lite-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Token Monitor Lite"
    },
    "portable": {
      "artifactName": "Token-Monitor-Lite-${version}.${ext}"
    }
  }
}
